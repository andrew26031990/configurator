#AddDefaultCharset utf-8
RewriteEngine On
RewriteRule ^cat/kompyutery$ index.php?cat=kompyutery [L,NC]

RewriteCond %{HTTP_HOST} ^configurator.pcmarket\.uz [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.configurator.pcmarket.uz/$1 [R,L]

RewriteBase     /

RewriteRule ^(.*)/$ /$1 [L,R=301]
RewriteRule ^(\w+)$ index.php?cat=$1 [L,NC]
#RewriteRule ^cat/(\w+)$ index.php?cat=$1 [L,NC]



#php_value display_errors 1
#php_value display_startup_errors 1
#php_value error_reporting E_ALL

#Session timeout
php_value session.cookie_lifetime 86400
php_value session.gc_maxlifetime 86400

<FilesMatch "\.(html|htm|js|css)$">
FileETag None
<ifModule mod_headers.c>
Header unset ETag
Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</ifModule>
</FilesMatch>

# ------------------------------------------------------------------
#  Защита файлов, которым нечего делать в вебруте
# ------------------------------------------------------------------

Options -Indexes

# Дампы, конфиги, логи, служебные файлы
<FilesMatch "(?i)\.(sql|ini|log|bak|old|orig|save|swp|dist|example|md|sh|json|lock|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(config\.local\.php|error_log|\.git.*|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Каталог .git целиком
RedirectMatch 404 /\.git

# ------------------------------------------------------------------
#  Заголовки безопасности
# ------------------------------------------------------------------

# X-Frame-Options здесь намеренно не ставится: конфигуратор рассчитан
# на встраивание в iframe на сайте магазина. Запрет фрейминга включён
# точечно для админки и страницы входа (см. security.php).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
